---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import LabLayout from '../../layouts/LabLayout.astro';

export const getStaticPaths = (async () => {
  const labs = await getCollection('labs');
  return labs.map((lab) => ({ params: { slug: lab.id }, props: { lab } }));
}) satisfies GetStaticPaths;

const { lab } = Astro.props as { lab: CollectionEntry<'labs'> };
const { Content, headings } = await render(lab);
---

<LabLayout lab={lab} headings={headings}>
  <Content />
</LabLayout>
