---
interface Props {
  type?: 'note' | 'tip' | 'warning';
  title?: string;
}

const { type = 'note', title } = Astro.props;
const defaultTitle = { note: 'Note', tip: 'Tip', warning: 'Warning' }[type];
---

<aside class={`callout callout-${type}`} role="note">
  <p class="callout-title">{title ?? defaultTitle}</p>
  <div class="callout-body"><slot /></div>
</aside>
