---
/**
 * Per-step duration, placed right after a step's `##` heading.
 * The lab script reads data-minutes for the sidebar and the remaining-time estimate.
 */
interface Props {
  minutes: number;
}

const { minutes } = Astro.props;
---

<p class="step-duration" data-minutes={minutes}>
  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
    <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M8 4.5V8l2.5 1.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
  </svg>
  Estimasi {minutes} menit
</p>
